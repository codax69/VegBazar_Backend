# MongoDB connection string
# Use mongodb:// for standalone/local or mongodb+srv:// for Atlas clusters
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/VegBazarDB?retryWrites=true&w=majority
# Optional: override the database name if DB_URI does not include it
DB_NAME=VegBazarDB

# Razorpay keys for online payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret

# OpenAI API key for AI chat
OPENAI_API_KEY=your_openai_api_key

# Groq API configuration for VegBazar AI Assistant
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Other example variables
PORT=4000
FRONTEND_URL=http://localhost:3000
EMAIL_USER=example@gmail.com
EMAIL_PASS=your_email_password
ADMIN_EMAIL=admin@example.com
